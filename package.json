{
  "name": "@qawolf/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for agents, CI, and humans to interact with QA Wolf",
  "license": "Apache-2.0",
  "bin": {
    "qawolf": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "bun scripts/genFlowsVersions.ts",
    "build": "bun build ./src/main.ts --outfile dist/cli.js --target node --external @napi-rs/keyring --external @qawolf/flow-targets --external @qawolf/flows --external playwright --external playwright-core --external @qawolf/emails --external @qawolf/testkit",
    "postbuild": "./scripts/postbuild.sh",
    "prebuild:binary": "bun scripts/genFlowsVersions.ts",
    "build:binary": "bun build --compile --bytecode ./src/main.ts --outfile dist/qawolf --external @qawolf/emails --external @qawolf/testkit",
    "dev": "bun run src/main.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install:binary": "bun run build:binary && mkdir -p ~/.local/bin && cp dist/qawolf ~/.local/bin/qawolf",
    "install:local": "bun run build && npm link",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "uninstall:local": "npm unlink -g @qawolf/cli",
    "uninstall:binary": "rm ~/.local/bin/qawolf"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@napi-rs/keyring": "1.3.0",
    "@playwright/test": "1.60.0",
    "@qawolf/emails": "1.0.0",
    "@qawolf/flow-targets": "1.0.0",
    "@qawolf/flows": "0.1.1",
    "@qawolf/testkit": "1.0.0",
    "commander": "14.0.3",
    "env-paths": "4.0.0",
    "playwright": "1.60.0",
    "superjson": "2.2.6",
    "tar": "7.5.15",
    "tinyglobby": "0.2.16",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.14",
    "knip": "6.14.0",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.11"
}
