{
  "name": "@qawolf/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for agents, CI, and humans to interact with QA Wolf",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "qawolf": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/main.ts --outfile dist/cli.js --target node --external @napi-rs/keyring",
    "postbuild": "./scripts/postbuild.sh",
    "build:binary": "bun build --compile --bytecode ./src/main.ts --outfile dist/qawolf",
    "dev": "bun run src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:binary": "bun run build:binary && mkdir -p ~/.local/bin && cp dist/qawolf ~/.local/bin/qawolf",
    "install:local": "bun run build && npm link",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "uninstall:local": "npm unlink -g @qawolf/cli"
  },
  "dependencies": {
    "@clack/prompts": "1.3.0",
    "@napi-rs/keyring": "1.3.0",
    "commander": "14.0.3",
    "env-paths": "4.0.0",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "14.0.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.13",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.6.1",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  }
}
