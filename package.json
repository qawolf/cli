{
  "name": "@qawolf/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Tools for agents, CI, and humans to interact with QA Wolf",
  "license": "Apache-2.0",
  "bin": {
    "qawolf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir dist --entry-naming=\"cli.[ext]\" --target node --external @napi-rs/keyring --external @qawolf/flow-targets --external @qawolf/flows --external playwright --external playwright-core --external @qawolf/emails --external @qawolf/testkit --sourcemap=external",
    "postbuild": "./scripts/postbuild.sh",
    "build:binary": "bun build --compile ./src/main.ts --outfile dist/qawolf --external @qawolf/emails --external @qawolf/testkit --define 'process.env.QAWOLF_COMPILED=\"true\"'",
    "dev": "bun run src/main.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install:binary": "bun run build:binary && mkdir -p ~/.local/bin && cp dist/qawolf ~/.local/bin/qawolf",
    "install:local": "bun run build && npm link",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "bun scripts/genDependencyVersions.ts && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "uninstall:local": "npm unlink -g @qawolf/cli",
    "version-packages": "changeset version",
    "uninstall:binary": "rm ~/.local/bin/qawolf"
  },
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "@napi-rs/keyring": "1.3.0",
    "@playwright/test": "1.60.0",
    "@qawolf/emails": "1.1.1",
    "@qawolf/flow-targets": "1.0.0",
    "@qawolf/flows": "0.1.1",
    "@qawolf/testkit": "1.1.1",
    "appium": "2.11.3",
    "appium-uiautomator2-driver": "3.7.0",
    "appium-xcuitest-driver": "9.10.5",
    "commander": "14.0.3",
    "env-paths": "4.0.0",
    "picomatch": "4.0.4",
    "pino": "10.3.1",
    "playwright": "1.58.2",
    "superjson": "2.2.6",
    "tar": "7.5.16",
    "tinyglobby": "0.2.17",
    "webdriverio": "9.27.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.14",
    "@types/picomatch": "4.0.3",
    "knip": "6.16.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13"
}
