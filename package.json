{
  "name": "@qawolf/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for agents, CI, and humans to interact with QA Wolf",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "qawolf": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/main.ts --outfile dist/cli.js --target node",
    "build:binary": "bun build --compile --bytecode ./src/main.ts --outfile dist/qawolf",
    "dev": "bun run src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/bun": "^1.0.10",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.0",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  },
  "packageManager": "bun@1.3.11"
}
